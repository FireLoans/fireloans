# Copy this file to .env.local and fill in real values. Never commit .env.local.
# All variables here are read server-side only   none are prefixed NEXT_PUBLIC_,
# so none of them are ever exposed to the browser.

# Required for the "Request My Free Assessment" contact form to actually send email
# (src/app/api/contact/route.ts). Get a key at https://resend.com — the sending domain
# (fireloans.com.au) must be verified in the Resend dashboard before it can send from
# noreply@fireloans.com.au. Without this set, form submissions fail with a clear error
# rather than silently disappearing.
RESEND_API_KEY=

# Optional secondary news sources (src/lib/news/). The /news page works fully without
# these   RSS feeds are the primary source and need no key. Adding these just widens
# coverage.
NEWSDATA_API_KEY=
GNEWS_API_KEY=

# Signs the FIRE Vault access-gate session cookie (src/lib/fire-vault/session.ts). FIRE Vault
# stores no accounts or user data anywhere   this secret is the only thing that makes the
# cookie unforgeable. Required in production (the app throws without it there); in development
# an insecure fallback is used with a console warning. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FIRE_VAULT_SESSION_SECRET=

# Required for FIRE Vault's "email me my access code" step (src/app/api/fire-vault/send-code/route.ts).
# Sent via Gmail SMTP, not Resend (the contact form above uses Resend — these are independent).
# Setup: the Gmail account needs 2-Step Verification turned on, then generate an App Password at
# https://myaccount.google.com/apppasswords (a normal Gmail password is rejected by Google's SMTP
# servers). GMAIL_USER is the full Gmail address; GMAIL_APP_PASSWORD is the 16-character app
# password Google generates (paste it with or without the spaces Google displays it with).
GMAIL_USER=
GMAIL_APP_PASSWORD=
